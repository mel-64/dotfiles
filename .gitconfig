[include]
	path = .git_id
[commit]
	gpgsign = true
[gpg]
	format = ssh
[alias]
	amend = commit -C HEAD --amend
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	line-numbers = true
[merge]
	conflictStyle = diff3
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
